# Required: one Discord webhook (Server Settings → Integrations → Webhooks → New Webhook → Copy URL)
DISCORD_WEBHOOK_URL=

# Optional: one webhook per tier channel (alerts.route_by: tier). Unset ones fall back to DISCORD_WEBHOOK_URL.
DISCORD_WEBHOOK_BIG_TECH=
DISCORD_WEBHOOK_TIER1=
DISCORD_WEBHOOK_TIER2=
DISCORD_WEBHOOK_TIER3=
DISCORD_WEBHOOK_OTHER=
DISCORD_WEBHOOK_PHD=
DISCORD_WEBHOOK_OPS=
# With alerts.route_by: level instead
DISCORD_WEBHOOK_INTERNSHIPS=
DISCORD_WEBHOOK_NEWGRAD=

# Optional: "📄 Create resume" button on every alert. Needs a Discord bot (README → Resume button).
# When both are set, alerts are posted by the bot (with buttons) instead of the webhook.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional per-tier channels for bot mode (alerts.route_by: tier); unset ones fall back to DISCORD_CHANNEL_ID.
# `python -m jobalerts setup-channels` creates them and fills these in (the bot needs Manage Channels once).
DISCORD_CHANNEL_BIG_TECH=
DISCORD_CHANNEL_TIER1=
DISCORD_CHANNEL_TIER2=
DISCORD_CHANNEL_TIER3=
DISCORD_CHANNEL_OTHER=
DISCORD_CHANNEL_PHD=
DISCORD_CHANNEL_OPS=
# With alerts.route_by: level instead
DISCORD_CHANNEL_INTERNSHIPS=
DISCORD_CHANNEL_NEWGRAD=

# Optional: https://healthchecks.io ping URL — emails you if the daemon stops running
HEALTHCHECK_URL=

